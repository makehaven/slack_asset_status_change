<?php

/**
 * @file
 * Contains Slack Asset Status Change module code.
 */

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_presave().
 *
 * For nodes of bundle "item", stores the original status taxonomy term ID.
 */
function slack_asset_status_change_entity_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' &&
      $entity->bundle() === 'item' &&
      $entity->hasField('field_item_status') &&
      !$entity->isNew()) {
    if (isset($entity->original)) {
      $original_node = $entity->original;
      if ($original_node->hasField('field_item_status')) {
        $original_tid = $original_node->get('field_item_status')->target_id;
        // Store as a temporary property.
        $entity->original_status_tid = $original_tid;
      }
    }
  }
}

/**
 * Implements hook_entity_update().
 *
 * Checks if the status field changed and posts to Slack.
 */
function slack_asset_status_change_entity_update(EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'node' &&
      $entity->bundle() === 'item' &&
      $entity->hasField('field_item_status')) {
    $new_tid = $entity->get('field_item_status')->target_id;
    if (isset($entity->original_status_tid) && $entity->original_status_tid != $new_tid) {
      slack_asset_status_change_notify($entity, $entity->original_status_tid, $new_tid);
    }
    else {
      \Drupal::logger('slack_asset_status_change')->notice('Status field did not change for node ID: @nid', ['@nid' => $entity->id()]);
    }
  }
}

/**
 * The status a member report lands in before staff have looked at it.
 *
 * Mirrors \Drupal\asset_status\Service\AssetAvailability, which treats this
 * label as "still usable, not confirmed by staff".
 */
const SLACK_ASSET_STATUS_CHANGE_UNCONFIRMED = 'Reported Concern';

/**
 * Decides whether a status transition is worth telling the tool channel.
 *
 * The tool's Slack channel is a member channel. It should hear about
 * confirmed changes only: a tool going Offline or Degraded after staff have
 * looked at it, coming back to Operational, being retired. An unconfirmed
 * member report (Reported Concern) is not announced, and neither is that
 * report being cleared back to Operational, because nothing was announced
 * in the first place. The shop manager's reminders about unconfirmed
 * reports come from asset_status's stale monitor, in the staff channel.
 *
 * @param string|null $old_status
 *   Label of the previous status term, or NULL/'' when unknown.
 * @param string|null $new_status
 *   Label of the new status term, or NULL/'' when unknown.
 *
 * @return bool
 *   TRUE when the transition should be posted.
 */
function slack_asset_status_change_should_post(?string $old_status, ?string $new_status): bool {
  $old_status = trim((string) $old_status);
  $new_status = trim((string) $new_status);
  if ($new_status === '' || $old_status === $new_status) {
    return FALSE;
  }
  if ($new_status === SLACK_ASSET_STATUS_CHANGE_UNCONFIRMED) {
    return FALSE;
  }
  if ($old_status === SLACK_ASSET_STATUS_CHANGE_UNCONFIRMED && $new_status === 'Operational') {
    return FALSE;
  }
  return TRUE;
}

/**
 * Resolves the Slack channel for a tool: its own, else its area's.
 */
function slack_asset_status_change_channel_for($node): string {
  if ($node->hasField('field_item_slack_channel') && !$node->get('field_item_slack_channel')->isEmpty()) {
    return (string) $node->get('field_item_slack_channel')->value;
  }
  if ($node->hasField('field_item_area_interest') && !$node->get('field_item_area_interest')->isEmpty()) {
    $interest_tid = $node->get('field_item_area_interest')->target_id;
    $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($interest_tid);
    if ($term && $term->hasField('field_interest_slack_channel') && !$term->get('field_interest_slack_channel')->isEmpty()) {
      return (string) $term->get('field_interest_slack_channel')->value;
    }
  }
  // One machine of a multi-unit tool carries no channel of its own: use the
  // tool's (asset_status's unit manager knows the parent).
  $parent = slack_asset_status_change_unit_parent($node);
  if ($parent) {
    return slack_asset_status_change_channel_for($parent);
  }
  return '';
}

/**
 * The tool a unit belongs to, or NULL for an ordinary tool.
 *
 * Optional integration with asset_status's multi-unit tools: without that
 * service every node is its own tool.
 */
function slack_asset_status_change_unit_parent($node) {
  if (!\Drupal::hasService('asset_status.units')) {
    return NULL;
  }
  $units = \Drupal::service('asset_status.units');
  return $units->isUnit($node) ? $units->getParent($node) : NULL;
}

/**
 * "Laser 2 (32x18 ULS Laser Cutter)" for a unit, the plain title otherwise.
 */
function slack_asset_status_change_display_title($node): string {
  $parent = slack_asset_status_change_unit_parent($node);
  return $parent ? sprintf('%s (%s)', $node->label(), $parent->label()) : (string) $node->label();
}

/**
 * Builds and posts the tool-channel message for one status transition.
 *
 * @param \Drupal\Core\Entity\EntityInterface $node
 *   The tool node.
 * @param int|string|null $old_tid
 *   Previous status term ID.
 * @param int|string|null $new_tid
 *   New status term ID.
 */
function slack_asset_status_change_notify(EntityInterface $node, $old_tid, $new_tid): void {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $old_term = $old_tid ? $storage->load($old_tid) : NULL;
  $new_term = $new_tid ? $storage->load($new_tid) : NULL;
  $old_status = $old_term ? $old_term->label() : '';
  $new_status = $new_term ? $new_term->label() : '';
  $asset_name = slack_asset_status_change_display_title($node);
  $logger = \Drupal::logger('slack_asset_status_change');

  if (!slack_asset_status_change_should_post($old_status, $new_status)) {
    $logger->notice('Not announcing @from → @to for @title (nid @nid): unconfirmed status.', [
      '@from' => $old_status,
      '@to' => $new_status,
      '@title' => $asset_name,
      '@nid' => $node->id(),
    ]);
    return;
  }

  // The channel never heard about an unconfirmed report, so a transition out
  // of it reads as a plain announcement rather than a change.
  if ($old_status === SLACK_ASSET_STATUS_CHANGE_UNCONFIRMED || $old_status === '') {
    $message = "$asset_name is now $new_status.";
  }
  else {
    $message = "$asset_name has been changed from $old_status to $new_status.";
  }
  if (!empty($node->_asset_status_log_message)) {
    $message .= "\nReason/Details: " . $node->_asset_status_log_message;
  }

  $slack_channel = slack_asset_status_change_channel_for($node);
  $logger->notice('Posting status change to Slack channel @channel: @message', ['@channel' => $slack_channel, '@message' => $message]);
  slack_asset_status_change_post_to_slack($slack_channel, $message);
}

/**
 * Posts a message to the specified Slack channel.
 */
function slack_asset_status_change_post_to_slack($channel, $message) {
  // Only post on the Pantheon live environment. On dev, test, and local Lando
  // the PANTHEON_ENVIRONMENT variable is either absent or not 'live'.
  $env = $_ENV['PANTHEON_ENVIRONMENT'] ?? getenv('PANTHEON_ENVIRONMENT') ?: NULL;
  if ($env !== 'live') {
    \Drupal::logger('slack_asset_status_change')->notice('Skipping Slack post on @env environment.', ['@env' => $env ?? 'local']);
    return;
  }

  $webhook_url = \Drupal::config('slack_connector.settings')->get('webhook_url');

  if (empty($webhook_url)) {
    \Drupal::logger('slack_asset_status_change')->error('Slack webhook URL is not configured in Slack Connector.');
    return;
  }

  try {
    $response = \Drupal::httpClient()->post($webhook_url, [
      'headers' => ['Content-Type' => 'application/json'],
      'json' => [
        'channel' => $channel,
        'text' => $message,
      ],
    ]);
    \Drupal::logger('slack_asset_status_change')->notice('Slack response: @response', ['@response' => $response->getBody()->getContents()]);
  }
  catch (\Exception $e) {
    \Drupal::logger('slack_asset_status_change')->error('Slack post failed: @error', ['@error' => $e->getMessage()]);
  }
}

/**
 * Helper function for the Rules action.
 * Sends a Slack message for a given node.
 */
function slack_asset_status_change_send_message_from_node($node) {
  if ($node->bundle() === 'item' && $node->hasField('field_item_status')) {
    // Use the stored original status if available.
    $new_tid = $node->get('field_item_status')->target_id;
    $original_tid = isset($node->original_status_tid) ? $node->original_status_tid : $new_tid;
    slack_asset_status_change_notify($node, $original_tid, $new_tid);
  }
}
